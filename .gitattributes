# Normalize text sources; the Windows double-click entry point uses CRLF.
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.example text eol=lf
*.conf text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
/LICENSE text eol=lf
/Start.cmd text eol=crlf